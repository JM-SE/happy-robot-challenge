TMS_HOST=127.0.0.1
TMS_PORT=9000
TMS_AUTH_TOKEN=local-test-token
TMS_CONNECT_TIMEOUT_MS=3000
TMS_RESPONSE_TIMEOUT_MS=5000
TMS_MAX_FRAME_BYTES=4096
# Mock-only fault controls; leave disabled for the normal happy path.
TMS_MOCK_SCENARIO=none
TMS_MOCK_DELAY_MS=10
TMS_MOCK_FRAGMENT_SIZE=1
# Real TMS validation is opt-in and must use authorized, server-side values.
# TMS_MODE=real
# TMS_ENV=non-production
# TMS_REAL_ENABLED=true
# TMS_REAL_TARGET_PIN=<approved-host>:<approved-port>
# TMS_REAL_TARGET_ALLOWLIST=<approved-host>:<approved-port> # independent comma-separated candidate targets
# TMS_REAL_TRANSPORT_APPROVED=true # private-network compensating control for plaintext TCP
# Optional explicit probes for the real DEBUG_ECHO runner:
# TMS_REAL_ECHO_EXTRAS=true
# TMS_REAL_ECHO_AUTH_INVALID=true
